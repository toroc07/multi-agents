{
  "name": "multi-agents",
  "version": "0.1.0",
  "description": "Hub para que agentes de IA de cualquier tipo (Claude Code, Codex, OpenCode, Gemini CLI, Aider...) colaboren en paralelo desde varias PCs: mensajes, tareas, bloqueo de archivos y dashboard.",
  "license": "MIT",
  "author": "Carlos Toro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toroc07/multi-agents.git"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "multi-agent",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "collaboration"
  ],
  "type": "module",
  "bin": {
    "multi-agents": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run test/state.test.ts test/paths.test.ts test/init.test.ts",
    "hub": "node dist/cli.js hub"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
